{
  "manifest_version": 3,
  "name": "GitHub Actions Workflow Tree",
  "version": "1.2.0",
  "description": "Groups the GitHub Actions workflow sidebar into a collapsible tree. Supports per-repo rule profiles.",
  "permissions": ["storage", "tabs"],
  "optional_host_permissions": ["https://*/*"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}